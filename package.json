{
  "name": "@tenkicloud/openclaw-sandbox",
  "version": "0.1.0",
  "description": "OpenClaw sandbox backend for Tenki Cloud microVM sessions via the @tenkicloud/sandbox SDK.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxorLabs/openclaw-tenki-sandbox"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tenkicloud/sandbox": "0.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@tenkicloud/openclaw-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "bundledDist": true
    }
  }
}
