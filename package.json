{
  "name": "@tenkicloud/openclaw",
  "version": "0.3.1",
  "description": "OpenClaw sandbox backend for Luxor Sandbox microVM sessions on Luxor Agent Cloud by Luxor AI.",
  "homepage": "https://luxor.ai/docs",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "sandbox",
    "luxor",
    "luxor-ai",
    "luxor-sandbox",
    "luxor-agent-cloud"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxorLabs/tenki-openclaw"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tenkicloud/sandbox": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@tenkicloud/openclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1-2"
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "bundledDist": true
    }
  }
}
